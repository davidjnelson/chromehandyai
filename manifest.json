{
  "manifest_version": 3,
  "name": "Handy AI Scripts",
  "short_name": "Handy AI",
  "version": "0.2.1",
  "description": "Generates stroker scripts from video motion on Pornhub and syncs them to The Handy. Also imports and exports .funscript files.",
  "minimum_chrome_version": "121",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Handy AI Scripts",
    "default_popup": "src/options/options.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": false
  },
  "background": {
    "service_worker": "src/background.js",
    "scripts": [
      "src/shared/handy.js",
      "src/background.js"
    ]
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "*://*.pornhub.com/*",
    "*://*.pornhubpremium.com/*",
    "*://*.phncdn.com/*",
    "https://www.handyfeeling.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.pornhub.com/view_video.php*",
        "*://*.pornhub.com/embed/*",
        "*://*.pornhubpremium.com/view_video.php*",
        "*://*.pornhubpremium.com/embed/*"
      ],
      "js": [
        "src/shared/funscript.js",
        "src/shared/motion.js",
        "src/shared/live.js",
        "src/content/store.js",
        "src/content/scanner.js",
        "src/content/live.js",
        "src/content/panel.js",
        "src/content/main.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "cdn_cors",
        "enabled": true,
        "path": "rules/cdn-cors.json"
      }
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "handy-ai-scripts@local",
      "strict_min_version": "128.0"
    },
    "gecko_android": {
      "strict_min_version": "128.0"
    }
  }
}
